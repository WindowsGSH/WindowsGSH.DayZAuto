{
  "id": "dayz-auto",
  "name": "DayZ Dedicated Server",
  "version": "1.1.0",
  "author": "Shenniko",
  "description": "WindowsGSH module for installing, configuring, and running a stable DayZ dedicated server.",
  "url": "https://github.com/WindowsGSH/WindowsGSH.DayZAuto",
  "homepage": "https://community.bistudio.com/wiki/DayZ:Server_Configuration",
  "repository": "https://github.com/WindowsGSH/WindowsGSH.DayZAuto",
  "sourceUrl": "https://github.com/WindowsGSH/WindowsGSH.DayZAuto",
  "color": "#1E8449",
  "moduleApiVersion": "1.0",
  "minimumWindowsGshVersion": "0.1.0",
  "type": "csharp",
  "entry": "WindowsGSH.Modules.DayZ.DayZModule",
  "steam": { "appId": "223350", "anonymous": true, "validate": true },
  "entryPoints": { "start": "DayZServer_x64.exe", "processName": "DayZServer_x64" },
  "runtime": {
    "allowsEmbeddedConsole": false,
    "consoleStrategy": "LogTailOnly",
    "logDirectory": "profiles",
    "logPattern": "*.RPT",
    "portIncrements": 4,
    "queryProtocol": "process",
    "defaultArguments": "-config=serverDZ.cfg -port={network.port} -profiles=profiles -doLogs -adminLog -netLog -freezeCheck {server.additionalArguments}",
    "stop": { "strategy": "closeWindow", "waitMilliseconds": 15000, "killAfterTimeout": true }
  },
  "capabilities": { "directConnection": true },
  "configFields": [
    { "key": "server.name", "label": "Server Name", "type": "Text", "defaultValue": "DayZ Dedicated Server", "required": true, "group": "Server" },
    { "key": "server.description", "label": "Description", "type": "Text", "defaultValue": "A WindowsGSH DayZ server", "group": "Server" },
    { "key": "server.password", "label": "Join Password", "type": "Password", "defaultValue": "", "group": "Security" },
    { "key": "server.adminPassword", "label": "Administrator Password", "type": "Password", "defaultValue": "", "group": "Security" },
    { "key": "server.maxPlayers", "label": "Max Players", "type": "Number", "defaultValue": 60, "minimum": 1, "maximum": 127, "group": "Server" },
    { "key": "server.mission", "label": "Mission Template", "type": "Text", "defaultValue": "dayzOffline.chernarusplus", "required": true, "group": "World", "description": "MissionName.TerrainName, for example dayzOffline.chernarusplus." },
    { "key": "server.instanceId", "label": "Instance ID", "type": "Number", "defaultValue": 1, "minimum": 1, "maximum": 9999, "group": "World" },
    { "key": "network.port", "label": "Base Game Port", "type": "Port", "defaultValue": 2302, "required": true, "minimum": 1, "maximum": 65532, "group": "Network", "description": "The module reserves UDP base through base + 3; Steam query is base + 3." },
    { "key": "server.thirdPerson", "label": "Allow Third Person", "type": "Boolean", "defaultValue": true, "group": "Gameplay" },
    { "key": "server.crosshair", "label": "Allow Crosshair", "type": "Boolean", "defaultValue": true, "group": "Gameplay" },
    { "key": "server.additionalArguments", "label": "Additional Arguments", "type": "CommandLine", "defaultValue": "", "group": "Launch", "description": "Trusted raw arguments. Use this for -mod/-serverMod only after installing and signing the corresponding Workshop content." }
  ],
  "ports": [
    { "id": "dayz-udp", "name": "DayZ Game, Steam, and Query Ports", "protocol": "udp", "configField": "network.port", "rangeLength": 4, "required": true }
  ],
  "backupTargets": [
    { "key": "server-config", "label": "Server Configuration", "path": "serverDZ.cfg", "type": "file", "required": true },
    { "key": "missions", "label": "Mission Storage and Persistence", "path": "mpmissions", "type": "directory", "required": true },
    { "key": "profiles", "label": "Profiles, Logs, and BattlEye Configuration", "path": "profiles", "type": "directory" }
  ],
  "addons": []
}
